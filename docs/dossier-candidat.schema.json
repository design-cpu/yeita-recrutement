{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yeichati.github.io/yeita-recrutement/docs/dossier-candidat.schema.json",
  "title": "Dossier candidat Yeita",
  "description": "Ce que les entretiens EC1 et EC2 produisent pour un candidat. Version 1, octobre 2026.",
  "type": "object",
  "required": ["schema", "version", "id", "candidat", "restitution", "meta"],
  "properties": {
    "schema": {"const": "yeita-dossier-candidat"},
    "version": {"const": 1},
    "id": {"type": "string", "description": "Identifiant local (cand-…). L'ATS fournira le sien."},
    "candidat": {
      "type": "object",
      "required": ["nom"],
      "properties": {
        "nom": {"type": "string"},
        "role": {"enum": ["PM", "PrD"]}
      }
    },
    "ec1": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ec1"}]},
    "ec2": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ec2"}]},
    "restitution": {
      "type": "object",
      "properties": {
        "etat": {"enum": ["ec1", "ec2", "hire"], "description": "Arrêt après l'EC1, après l'EC2, ou embauche"}
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "creeLe": {"type": "string", "format": "date-time"},
        "modifieLe": {"type": "string", "format": "date-time"}
      }
    }
  },
  "$defs": {
    "valeur": {"enum": ["collectif", "sans-chichi", "explorateur", "meilleure-version"]},
    "texte": {"type": "string"},
    "ec1": {
      "type": "object",
      "properties": {
        "date": {"type": "string", "description": "AAAA-MM-JJ"},
        "recruteur": {"type": "string"},
        "observateur": {"type": "string"},
        "format": {"enum": ["presentiel", "visio"]},
        "match": {
          "type": "object",
          "properties": {
            "dominante": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/valeur"}]},
            "seconde": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/valeur"}]},
            "partielle": {"type": "boolean"},
            "pourquoi": {"type": "string"},
            "source": {"enum": ["decompte", "jeu-en-ligne", "saisie", "code"]}
          }
        },
        "percu": {"type": "string", "description": "Sur la carte"},
        "valeurs": {"type": "object", "description": "Interne. Une note par valeur.", "additionalProperties": {"type": "string"}},
        "employabilite": {
          "type": "object",
          "properties": {
            "demarrage": {"enum": [null, "auto", "binome", "cadre", "non"], "description": "Interne"},
            "note": {"type": "string", "description": "Interne"},
            "criteres": {
              "type": "object",
              "description": "Clé : identifiant du critère dans data-employabilite.js",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "statut": {"enum": [null, "aligne", "a-discuter", "pas-aujourdhui"]},
                  "note": {"type": "string", "description": "Interne"},
                  "phrase": {"type": "string", "description": "Phrase pour le candidat"},
                  "afficher": {"type": "boolean", "description": "Apparaît sur la carte si vrai"}
                }
              }
            }
          }
        },
        "diamants": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"enum": [null, "Fort", "À creuser", "Absent", "Non vu"]}},
        "vigilance": {"type": "string", "description": "Interne"},
        "questionsEC2": {"type": "string", "description": "Interne"},
        "reporteLe": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "ec2": {
      "type": "object",
      "properties": {
        "date": {"type": "string"},
        "pair": {"type": "string"},
        "role": {"enum": ["PM", "PrD"]},
        "palier": {"type": "integer", "minimum": 1, "maximum": 4},
        "notes": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": ["integer", "null"], "minimum": 0, "maximum": 4}},
        "exemples": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"type": "string"}, "description": "Interne"},
        "lecture": {"type": "string", "description": "Interne"},
        "aspirations": {"type": "string", "description": "Interne"},
        "suspens": {
          "type": "object",
          "description": "Points en suspens pour l'EC3. Interne.",
          "properties": {
            "palier": {"type": "string"},
            "solides": {"type": "string"},
            "creux": {"type": "string"},
            "questions": {"type": "string"},
            "contestation": {"type": "string"},
            "conditions": {"type": "string"}
          }
        },
        "reporteLe": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
