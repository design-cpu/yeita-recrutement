# Occupation des disques (deploy/verif-disque.sh). Lancée par recrutement-verif-disque.timer.
# Installation et mise à jour : deploy/README.md, « Sauvegardes ».
[Unit]
Description=Vérification de l'occupation des disques (recrutement)
# Après Docker s'il démarre, sans jamais le démarrer : un Docker arrêté pour une maintenance du serveur partagé
# n'est pas relancé par une sauvegarde ou une vérification (qui échoue alors et le signale).
After=docker.service

[Service]
Type=oneshot
User=deploy
Group=deploy
UMask=0077
WorkingDirectory=/opt/recrutement
ExecStart=/opt/recrutement/deploy/verif-disque.sh
TimeoutStartSec=5min
TimeoutStopSec=90
