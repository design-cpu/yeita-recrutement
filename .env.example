# Copier en .env (jamais commité) : cp .env.example .env && chmod 600 .env
# Tel quel, ce fichier sert au test local (cas B sur https://localhost, faux identifiants Google).
# Sur le serveur, changer obligatoirement : DOMAIN, OAUTH2_PROXY_REDIRECT_URL, COMPOSE_PROFILES (selon le cas),
# OAUTH2_PROXY_CLIENT_ID, OAUTH2_PROXY_CLIENT_SECRET, OAUTH2_PROXY_COOKIE_SECRET.
# deploy/deploy.sh refuse les valeurs d'exemple ci-dessous.

# Domaine servi. Sur le serveur : recrutement.yeita.fr
DOMAIN=localhost

# Client OAuth Google (type « Interne »), URI de redirection : https://<DOMAIN>/oauth2/callback
OAUTH2_PROXY_CLIENT_ID=exemple.apps.googleusercontent.com
OAUTH2_PROXY_CLIENT_SECRET=exemple-secret
OAUTH2_PROXY_REDIRECT_URL=https://localhost/oauth2/callback

# Secret des cookies, 32 caractères. À régénérer :
#   openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=exemple-a-regenerer-0123456789ab

# Cas B (aucun proxy sur 80 et 443) : caddy. Cas A (proxy existant) : laisser vide.
COMPOSE_PROFILES=caddy

# --- Sauvegardes (deploy/backup.sh, deploy/verif-disque.sh ; deploy/README.md, « Sauvegardes ») ---
# Facultatif pour déployer le site ; les deux scripts refusent ces valeurs d'exemple.
# Clé publique age (age1…) : créée sur un poste avec age-keygen, jamais sur le serveur ; la clé privée va au coffre.
AGE_RECIPIENT=age1exemplearemplacer
# Remote rclone de deploy et dossier du bucket OVH (région UE), de la forme <remote>:<bucket>/<dossier>.
RCLONE_DEST=ovh-exemple:bucket-exemple/recrutement
# Adresses de ping de deux contrôles healthchecks.io distincts (secrets).
HEALTHCHECK_SAUVEGARDE_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000001
HEALTHCHECK_DISQUE_URL=https://hc-ping.com/00000000-0000-0000-0000-000000000002
